NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://your-domain.ru
ADMIN_USER=manager
# Generate a random password, at least 20 characters. Do not commit .env.
ADMIN_PASSWORD=
SELLER_NAME=
SELLER_INN=
SELLER_ADDRESS=
# Optional; without an email, the privacy page points visitors to the store phone.
PRIVACY_EMAIL=
METRIKA_ID=
# Optional during an initial read-only deployment; required for storing leads.
DATABASE_URL=postgresql://user:password@host:5432/database
# Required with DATABASE_URL in production. Paste the Timeweb CA certificate.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# App Platform terminates HTTPS and forwards requests to this container.
TRUST_PROXY=1
