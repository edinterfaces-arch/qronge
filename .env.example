NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://your-domain.ru
ADMIN_USER=manager
# Generate a random password, at least 20 characters. Do not commit .env.
ADMIN_PASSWORD=
SELLER_NAME=
SELLER_INN=
SELLER_ADDRESS=
PRIVACY_EMAIL=
METRIKA_ID=
DATA_DIR=./data
# Enable only behind the bundled Caddy, with port 3000 NOT publicly exposed.
TRUST_PROXY=1
