NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://your-domain.ru
ADMIN_USER=manager
# Generate a random password, at least 20 characters. Do not commit .env.
ADMIN_PASSWORD=
SELLER_NAME=
SELLER_INN=
SELLER_ADDRESS=
PRIVACY_EMAIL=
METRIKA_ID=
# Set the connection string from the Timeweb PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/database
# Paste the CA certificate supplied by Timeweb. Keep newlines; wrap in quotes in .env.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# App Platform terminates HTTPS and forwards requests to this container.
TRUST_PROXY=1
